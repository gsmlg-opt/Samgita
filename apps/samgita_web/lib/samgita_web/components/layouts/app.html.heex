<.dm_appbar title="Samgita" title_to={~p"/"} class="appbar-primary" sticky>
  <:menu to={~p"/"} active={true}>{gettext("Agent Hub")}</:menu>
  <:user_profile>
    <.dm_theme_switcher id="theme-toggle" />
  </:user_profile>
</.dm_appbar>

<main id="main-content" class="bg-surface text-on-surface px-4 py-6 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    {@inner_content}
  </div>
</main>

<.flash_group flash={@flash} />
