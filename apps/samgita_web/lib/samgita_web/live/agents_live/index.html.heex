<section class="space-y-6" aria-labelledby="agents-title">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 id="agents-title" class="text-3xl font-bold">{gettext("Agents")}</h1>
      <p class="text-on-surface-variant">
        {gettext("Connected Agents, such as Codex, Synapsis and Sigma.")}
      </p>
    </div>
    <.dm_modal id="agent-add-modal" size="lg">
      <:trigger :let={id}>
        <.dm_btn id="agent-add-open" variant="primary" command="show-modal" commandfor={id}>
          {gettext("Add Agent")}
        </.dm_btn>
      </:trigger>
      <:title>{gettext("Add Agent")}</:title>
      <:body>
        <p :if={@form.params["kind"] == "codex"} class="mb-4 text-sm text-on-surface-variant">
          {gettext(
            "Run `codex app-server --listen ws://127.0.0.1:47811` on the machine. For another machine, forward its port first, for example `ssh -N -L 47812:127.0.0.1:47811 host`, and use ws://127.0.0.1:47812."
          )}
        </p>
        <p :if={@error} id="agent-error" role="alert" class="mb-4 text-error">{@error}</p>
        <p :if={@warning} id="agent-warning" role="alert" class="mb-4 text-warning">{@warning}</p>
        <.form for={@form} id="agent-add" phx-submit="add" phx-change="change" class="space-y-4">
          <input
            :for={key <- ~w(agent_command_id host_command_id enable_command_id confirmed)}
            type="hidden"
            name={"agent[#{key}]"}
            value={@form.params[key]}
          />
          <div class="grid gap-4">
            <.dm_input
              field={@form[:kind]}
              type="select"
              label={gettext("Type")}
              options={[{"Codex", "codex"}, {gettext("Samgita protocol Agent"), "agent"}]}
            />
            <.dm_input
              field={@form[:name]}
              label={gettext("Name")}
              placeholder="Codex on mbp"
              required
            />
            <.dm_input
              field={@form[:address]}
              label={gettext("Address")}
              placeholder={
                if @form.params["kind"] == "codex",
                  do: "ws://127.0.0.1:47811",
                  else: "wss://agent.example/app-server"
              }
              required={@form.params["kind"] == "codex"}
            />
          </div>
          <.dm_btn
            native_submit
            type="submit"
            variant="primary"
            phx-disable-with={gettext("Checking…")}
          >
            {if @warning, do: gettext("Add anyway"), else: gettext("Add")}
          </.dm_btn>
        </.form>
      </:body>
    </.dm_modal>
  </header>
  <p :if={@load_error} role="alert" class="text-error">{@load_error}</p>
  <.dm_card variant="bordered">
    <:title>{gettext("Agents")}</:title>
    <p :if={@page["data"] == []} id="agents-empty">
      {gettext("No Agents on this page. Use Add Agent to connect one.")}
    </p>
    <div class="overflow-x-auto">
      <.dm_table :if={@page["data"] != []} id="agents-list" data={@page["data"]}>
        <:col :let={agent} label={gettext("Agent")}>
          <.dm_link navigate={~p"/agents/#{agent["id"]}"}>{agent["name"]}</.dm_link>
          <span class="block text-xs text-on-surface-variant">{kind(agent)}</span>
        </:col>
        <:col :let={agent} label={gettext("Address")}>
          <span class="break-all">{address(@hosts[agent["id"]], agent)}</span>
          <span
            :if={(@hosts[agent["id"]] || %{})["same_machine_as"] not in [nil, []]}
            class="block text-xs text-warning agent-duplicate"
          >
            {gettext("Same machine as %{names}",
              names: Enum.join(@hosts[agent["id"]]["same_machine_as"], ", ")
            )}
          </span>
        </:col>
        <:col :let={agent} label={gettext("Status")}>
          <%= if host = @hosts[agent["id"]] do %>
            <.dm_badge variant={state_variant(state(host))} class="agent-state">
              {state(host)}
            </.dm_badge>
            <span :if={host["server_version"]} class="block text-xs">
              Codex {host["server_version"]}
            </span>
            <span :if={host["status"]["error"]} class="block text-xs text-error">
              {host["status"]["error"]}
            </span>
          <% else %>
            <span>{agent["availability"]}</span>
          <% end %>
        </:col>
        <:col :let={agent} label={gettext("Actions")}>
          <div :if={host = @hosts[agent["id"]]} class="flex flex-wrap gap-2">
            <.dm_btn
              :if={!host["enabled"]}
              id={"agent-start-#{host["id"]}"}
              size="sm"
              variant="primary"
              phx-click="start"
              phx-value-id={host["id"]}
            >
              {gettext("Start")}
            </.dm_btn>
            <.dm_btn
              :if={host["enabled"]}
              id={"agent-stop-#{host["id"]}"}
              size="sm"
              phx-click="stop"
              phx-value-id={host["id"]}
            >
              {gettext("Stop")}
            </.dm_btn>
            <.dm_btn
              :if={host["enabled"]}
              id={"agent-reconnect-#{host["id"]}"}
              size="sm"
              phx-click="reconnect"
              phx-value-id={host["id"]}
            >
              {gettext("Reconnect")}
            </.dm_btn>
          </div>
        </:col>
      </.dm_table>
    </div>
    <nav aria-label={gettext("Agent pages")} class="mt-4 flex items-center gap-4">
      <.dm_link
        :if={@page["offset"] > 0}
        patch={~p"/agents?offset=#{max(@page["offset"] - 25, 0)}"}
      >{gettext("Previous")}</.dm_link>
      <span>{gettext("%{total} registered", total: @page["total"])}</span>
      <.dm_link
        :if={@page["offset"] + 25 < @page["total"]}
        patch={~p"/agents?offset=#{@page["offset"] + 25}"}
      >{gettext("Next")}</.dm_link>
    </nav>
  </.dm_card>
</section>
