<section class="space-y-6" aria-labelledby="agents-title">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 id="agents-title" class="text-3xl font-bold">{gettext("Agents")}</h1>
      <p class="text-on-surface-variant">
        {gettext("Connected Agents, such as Codex, Synapsis and Sigma.")}
      </p>
    </div>
    <.dm_modal id="agent-add-modal" size="lg">
      <:trigger :let={id}>
        <.dm_btn id="agent-add-open" variant="primary" command="show-modal" commandfor={id}>
          {gettext("Add Agent")}
        </.dm_btn>
      </:trigger>
      <:title>{gettext("Add Agent")}</:title>
      <:body>
        <p :if={@error} id="agent-error" role="alert" class="mb-4 text-error">{@error}</p>
        <p :if={@warning} id="agent-warning" role="alert" class="mb-4 text-warning">{@warning}</p>
        <.form for={@form} id="agent-add" phx-submit="add" phx-change="change" class="space-y-4">
          <input
            :for={key <- ~w(agent_command_id host_command_id enable_command_id confirmed)}
            type="hidden"
            name={"agent[#{key}]"}
            value={@form.params[key]}
          />
          <div class="grid gap-4">
            <.dm_input
              field={@form[:kind]}
              type="select"
              label={gettext("Type")}
              options={[{"Codex", "codex"}, {gettext("Samgita protocol Agent"), "agent"}]}
            />
            <.dm_input
              field={@form[:name]}
              label={gettext("Name")}
              placeholder="Codex on mbp"
              required
            />
            <.dm_input
              :if={@form.params["kind"] == "codex"}
              field={@form[:location]}
              type="select"
              label={gettext("Where Codex runs")}
              options={[
                {gettext("This computer"), "local"},
                {gettext("Another computer over SSH"), "ssh"}
              ]}
            />
            <p
              :if={@form.params["kind"] == "codex" and @form.params["location"] != "ssh"}
              class="text-xs text-on-surface-variant"
            >
              {gettext(
                "Connects to the Codex app's daemon on the computer running Samgita. If it is not running, open the Codex app or run `codex app-server daemon start`."
              )}
            </p>
            <.dm_input
              :if={@form.params["kind"] == "codex" and @form.params["location"] == "ssh"}
              field={@form[:address]}
              label={gettext("SSH host")}
              placeholder="raven or user@host"
              required
            />
            <p
              :if={@form.params["kind"] == "codex" and @form.params["location"] == "ssh"}
              class="text-xs text-on-surface-variant"
            >
              {gettext(
                "Uses your SSH config, keys and known_hosts, and starts the Codex daemon there if needed. Reconnects by itself after network drops."
              )}
            </p>
            <.dm_input
              :if={@form.params["kind"] != "codex"}
              field={@form[:connection_mode]}
              type="select"
              label={gettext("Connection direction")}
              options={[
                {gettext("Samgita connects to Agent"), "websocket"},
                {gettext("Agent connects to Samgita"), "inbound_websocket"}
              ]}
            />
            <p
              :if={
                @form.params["kind"] != "codex" and
                  @form.params["connection_mode"] == "inbound_websocket"
              }
              class="text-sm text-on-surface-variant"
            >
              {gettext(
                "Connect the device to Samgita, then confirm its request below. No credential needs to be entered on the device."
              )}
            </p>
            <.dm_input
              :if={
                @form.params["kind"] != "codex" and
                  @form.params["connection_mode"] != "inbound_websocket"
              }
              field={@form[:address]}
              label={gettext("Address")}
              placeholder="wss://agent.example/app-server"
            />
          </div>
          <.dm_btn
            native_submit
            type="submit"
            variant="primary"
            phx-disable-with={gettext("Checking…")}
          >
            {if @warning, do: gettext("Add anyway"), else: gettext("Add")}
          </.dm_btn>
        </.form>
      </:body>
    </.dm_modal>
  </header>
  <p :if={@load_error} role="alert" class="text-error">{@load_error}</p>
  <.dm_card id="agent-connection-requests" variant="bordered">
    <:title>{gettext("Connection requests")}</:title>
    <p class="mb-4 text-sm text-on-surface-variant">
      {gettext(
        "Confirm a new device once. Confirmed devices reconnect automatically until their credential is revoked on the Agent page."
      )}
    </p>
    <p :if={@ingress_error} id="agent-ingress-error" role="alert" class="mb-4 text-error">
      {@ingress_error}
    </p>
    <p :if={@ingress.pending == []} id="agent-requests-empty">
      {gettext("No devices waiting for confirmation.")}
    </p>
    <div class="space-y-4">
      <article
        :for={request <- @ingress.pending}
        id={"agent-request-#{request.id}"}
        class="rounded border border-outline-variant p-4"
      >
        <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
          <div>
            <h3 class="font-semibold">{request.name}</h3>
            <p class="text-sm text-on-surface-variant">{request.implementation}</p>
            <p class="break-all text-xs text-on-surface-variant">{request.id}</p>
          </div>
          <.dm_badge variant="warning">{gettext("Awaiting confirmation")}</.dm_badge>
        </div>
        <.form
          for={@pairing_forms[request.id]}
          id={"agent-pairing-#{request.id}"}
          phx-change="pairing_change"
          phx-submit="approve_pairing"
          class="space-y-3"
        >
          <input
            :for={key <- ~w(request_id command_id expected_version)}
            type="hidden"
            name={"pairing[#{key}]"}
            value={@pairing_forms[request.id].params[key]}
          />
          <.dm_input
            field={@pairing_forms[request.id][:agent_id]}
            type="select"
            label={gettext("Agent identity")}
            options={pairing_options(@page["data"], @pairing_forms[request.id].params)}
            helper={
              gettext(
                "Choose a new Agent or an existing Agent from this page. Project roles are configured separately."
              )
            }
          />
          <div class="flex flex-wrap gap-2">
            <.dm_btn
              native_submit
              type="submit"
              variant="primary"
              phx-disable-with={gettext("Confirming…")}
            >
              {gettext("Confirm device")}
            </.dm_btn>
            <.dm_btn
              variant="ghost"
              phx-click="reject_pairing"
              phx-value-id={request.id}
              phx-disable-with={gettext("Rejecting…")}
            >
              {gettext("Reject")}
            </.dm_btn>
          </div>
        </.form>
      </article>
    </div>
  </.dm_card>
  <.dm_card variant="bordered">
    <:title>{gettext("Agents")}</:title>
    <p :if={@page["data"] == []} id="agents-empty">
      {gettext("No Agents on this page. Use Add Agent to connect one.")}
    </p>
    <div class="overflow-x-auto">
      <.dm_table :if={@page["data"] != []} id="agents-list" data={@page["data"]}>
        <:col :let={agent} label={gettext("Agent")}>
          <.dm_link navigate={~p"/agents/#{agent["id"]}"}>{agent["name"]}</.dm_link>
          <span class="block text-xs text-on-surface-variant">{kind(agent)}</span>
        </:col>
        <:col :let={agent} label={gettext("Address")}>
          <span class="break-all">{address(@hosts[agent["id"]], agent)}</span>
          <span
            :if={(@hosts[agent["id"]] || %{})["same_machine_as"] not in [nil, []]}
            class="block text-xs text-warning agent-duplicate"
          >
            {gettext("Same machine as %{names}",
              names: Enum.join(@hosts[agent["id"]]["same_machine_as"], ", ")
            )}
          </span>
        </:col>
        <:col :let={agent} label={gettext("Status")}>
          <%= if host = @hosts[agent["id"]] do %>
            <.dm_badge variant={state_variant(state(host))} class="agent-state">
              {state(host)}
            </.dm_badge>
            <span :if={host["server_version"]} class="block text-xs">
              Codex {host["server_version"]}
            </span>
            <span :if={host["status"]["error"]} class="block text-xs text-error">
              {host["status"]["error"]}
            </span>
          <% else %>
            <%= if inbound?(agent) do %>
              <.dm_badge
                variant={state_variant(inbound_state(agent, @ingress.connected))}
                class="agent-state"
              >
                {inbound_state(agent, @ingress.connected)}
              </.dm_badge>
            <% else %>
              <span>{agent["availability"]}</span>
            <% end %>
          <% end %>
        </:col>
        <:col :let={agent} label={gettext("Actions")}>
          <div class="flex flex-wrap gap-2">
            <.dm_btn
              :if={inbound?(agent) and Map.has_key?(@ingress.connected, agent["id"])}
              id={"agent-disconnect-#{agent["id"]}"}
              size="sm"
              phx-click="disconnect_inbound"
              phx-value-id={agent["id"]}
            >
              {gettext("Disconnect")}
            </.dm_btn>
            <div :if={host = @hosts[agent["id"]]} class="flex flex-wrap gap-2">
              <.dm_btn
                :if={!host["enabled"]}
                id={"agent-start-#{host["id"]}"}
                size="sm"
                variant="primary"
                phx-click="start"
                phx-value-id={host["id"]}
              >
                {gettext("Start")}
              </.dm_btn>
              <.dm_btn
                :if={host["enabled"]}
                id={"agent-stop-#{host["id"]}"}
                size="sm"
                phx-click="stop"
                phx-value-id={host["id"]}
              >
                {gettext("Stop")}
              </.dm_btn>
              <.dm_btn
                :if={host["enabled"]}
                id={"agent-reconnect-#{host["id"]}"}
                size="sm"
                phx-click="reconnect"
                phx-value-id={host["id"]}
              >
                {gettext("Reconnect")}
              </.dm_btn>
            </div>
            <.dm_btn
              id={"agent-remove-#{agent["id"]}"}
              size="sm"
              variant="error"
              confirm={
                gettext(
                  "Remove %{name}? Its connection will stop. Task and Attempt history is kept.",
                  name: agent["name"]
                )
              }
              confirm_title={gettext("Remove Agent")}
              confirm_text={gettext("Remove Agent")}
              phx-click="remove"
              phx-value-id={agent["id"]}
              phx-value-command={@removal_commands[agent["id"]].id}
              phx-value-version={@removal_commands[agent["id"]].version}
            >
              {gettext("Remove")}
            </.dm_btn>
          </div>
        </:col>
      </.dm_table>
    </div>
    <nav aria-label={gettext("Agent pages")} class="mt-4 flex items-center gap-4">
      <.dm_link
        :if={@page["offset"] > 0}
        patch={~p"/agents?offset=#{max(@page["offset"] - 25, 0)}"}
      >{gettext("Previous")}</.dm_link>
      <span>{gettext("%{total} registered", total: @page["total"])}</span>
      <.dm_link
        :if={@page["offset"] + 25 < @page["total"]}
        patch={~p"/agents?offset=#{@page["offset"] + 25}"}
      >{gettext("Next")}</.dm_link>
    </nav>
  </.dm_card>
</section>
