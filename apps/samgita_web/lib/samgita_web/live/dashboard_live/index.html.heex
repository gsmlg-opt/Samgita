<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-on-surface-variant">
        Command Center
      </p>
      <h1 class="text-3xl font-bold text-on-surface">Samgita Dashboard</h1>
    </div>
    <.link navigate={~p"/projects/new"}>
      <.dm_btn variant="primary">
        <.dm_mdi name="plus" class="mr-1 h-4 w-4" /> New Project
      </.dm_btn>
    </.link>
  </div>

  <%!-- Split Command Center --%>
  <div class="grid gap-6 lg:grid-cols-[22rem_minmax(0,1fr)] mb-8">
    <aside
      data-role="workspace-rail"
      class="rounded-lg border border-outline-variant bg-surface-container p-4"
    >
      <div class="mb-4 flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold text-on-surface">Workspaces</h2>
          <p class="text-xs text-on-surface-variant">Codex app-server launch targets</p>
        </div>
        <.dm_badge variant="secondary">{length(@projects)}</.dm_badge>
      </div>

      <div
        :if={@projects == []}
        class="rounded-md border border-dashed border-outline p-6 text-center"
      >
        <p class="text-sm text-on-surface-variant">No projects yet.</p>
        <.link navigate={~p"/projects/new"} class="mt-3 inline-block text-sm text-primary">
          Create your first project to get started.
        </.link>
      </div>

      <div :if={@projects != []} class="space-y-2">
        <.link
          :for={project <- @projects}
          navigate={~p"/projects/#{project}"}
          class="block rounded-md border border-outline-variant bg-surface p-3 transition-colors hover:bg-surface-container-high"
        >
          <% codex = codex_status(@codex_statuses, project) %>
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold text-on-surface">{project.name}</p>
              <p class="truncate text-xs text-on-surface-variant">{project.git_url}</p>
            </div>
            <.dm_badge variant={codex_status_badge(codex)} size="xs">{codex.state}</.dm_badge>
          </div>
          <div class="mt-2 flex items-center justify-between text-xs">
            <span class="text-on-surface-variant">
              {codex.mode || "local"} · {project.status}
            </span>
            <span class="font-medium text-primary">Open workspace</span>
          </div>
        </.link>
      </div>
    </aside>

    <section class="min-w-0 rounded-lg border border-outline-variant bg-surface-container p-5">
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
          <h2 class="text-2xl font-semibold text-on-surface">Codex app-server</h2>
          <p class="mt-1 max-w-2xl text-sm text-on-surface-variant">
            Launch a Codex workspace from a local path or SSH target, then connect with <span class="font-mono">codex --remote</span>.
          </p>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center text-xs">
          <div class="rounded-md bg-surface px-3 py-2">
            <p class="text-on-surface-variant">Projects</p>
            <p class="text-lg font-semibold text-on-surface">{length(@projects)}</p>
          </div>
          <div class="rounded-md bg-surface px-3 py-2">
            <p class="text-on-surface-variant">Running</p>
            <p class="text-lg font-semibold text-success">
              {Enum.count(@projects, &(&1.status == :running))}
            </p>
          </div>
          <div class="rounded-md bg-surface px-3 py-2">
            <p class="text-on-surface-variant">Servers</p>
            <p class="text-lg font-semibold text-primary">
              {Enum.count(@codex_statuses, fn {_id, status} -> status.state == :running end)}
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <%!-- Management Cards --%>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <.link navigate={~p"/agents"} class="block">
      <.dm_card
        body_class=""
        variant="bordered"
        class="p-6 hover:shadow-md transition-shadow h-full"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="p-2 bg-tertiary-container rounded-lg">
            <.dm_mdi name="robot" class="w-6 h-6 text-on-tertiary-container" />
          </div>
          <h3 class="text-lg font-semibold text-on-surface">Agents</h3>
        </div>
        <p class="text-sm text-on-surface-variant">View and manage agent definitions</p>
      </.dm_card>
    </.link>

    <.link navigate={~p"/mcp"} class="block">
      <.dm_card
        body_class=""
        variant="bordered"
        class="p-6 hover:shadow-md transition-shadow h-full"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="p-2 bg-primary-container rounded-lg">
            <.dm_mdi name="server-network" class="w-6 h-6 text-on-primary-container" />
          </div>
          <h3 class="text-lg font-semibold text-on-surface">MCP Servers</h3>
        </div>
        <p class="text-sm text-on-surface-variant">Configure Model Context Protocol servers</p>
      </.dm_card>
    </.link>

    <.link navigate={~p"/skills"} class="block">
      <.dm_card
        body_class=""
        variant="bordered"
        class="p-6 hover:shadow-md transition-shadow h-full"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="p-2 bg-secondary-container rounded-lg">
            <.dm_mdi name="book-open-variant" class="w-6 h-6 text-on-secondary-container" />
          </div>
          <h3 class="text-lg font-semibold text-on-surface">Skills</h3>
        </div>
        <p class="text-sm text-on-surface-variant">Manage Claude Code skills</p>
      </.dm_card>
    </.link>

    <.link navigate={~p"/references"} class="block">
      <.dm_card
        body_class=""
        variant="bordered"
        class="p-6 hover:shadow-md transition-shadow h-full"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="p-2 bg-tertiary-container rounded-lg">
            <.dm_mdi name="file-document-outline" class="w-6 h-6 text-on-tertiary-container" />
          </div>
          <h3 class="text-lg font-semibold text-on-surface">References</h3>
        </div>
        <p class="text-sm text-on-surface-variant">Loki Mode patterns and research</p>
      </.dm_card>
    </.link>
  </div>

  <h2 class="text-2xl font-bold text-on-surface mb-4">Projects</h2>

  <div :if={@projects == []} class="text-center py-16 text-on-surface-variant">
    <p class="text-lg">No projects yet.</p>
    <p class="mt-2">Create your first project to get started.</p>
  </div>

  <div class="grid gap-4">
    <.link :for={project <- @projects} navigate={~p"/projects/#{project}"} class="block">
      <.dm_card body_class="" variant="bordered" class="p-6 hover:shadow-md transition-shadow">
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-xl font-semibold text-on-surface">{project.name}</h2>
            <p class="text-sm text-on-surface-variant mt-1">{project.git_url}</p>
          </div>
          <div class="flex gap-2">
            <.dm_badge variant={status_badge_color(project.status)}>{project.status}</.dm_badge>
            <.dm_badge variant="secondary">{project.phase}</.dm_badge>
          </div>
        </div>
        <% stats = Map.get(@project_stats, project.id, %{}) %>
        <div
          :if={total_tasks(stats) > 0}
          class="mt-3 flex items-center gap-4 text-xs text-on-surface-variant"
        >
          <span class="text-success">{task_stat(stats, :completed)} done</span>
          <span class="text-primary">{task_stat(stats, :running)} running</span>
          <span class="text-warning">{task_stat(stats, :pending)} pending</span>
          <span :if={task_stat(stats, :failed) > 0} class="text-error">
            {task_stat(stats, :failed)} failed
          </span>
          <span :if={task_stat(stats, :dead_letter) > 0} class="text-on-surface-variant">
            {task_stat(stats, :dead_letter)} dead
          </span>
          <div class="flex-1 h-1.5 bg-surface-container rounded-full overflow-hidden flex">
            <div
              class="bg-success"
              style={"width: #{if total_tasks(stats) > 0, do: task_stat(stats, :completed) / total_tasks(stats) * 100, else: 0}%"}
            >
            </div>
            <div
              class="bg-primary"
              style={"width: #{if total_tasks(stats) > 0, do: task_stat(stats, :running) / total_tasks(stats) * 100, else: 0}%"}
            >
            </div>
            <div
              class="bg-error"
              style={"width: #{if total_tasks(stats) > 0, do: task_stat(stats, :failed) / total_tasks(stats) * 100, else: 0}%"}
            >
            </div>
          </div>
        </div>
      </.dm_card>
    </.link>
  </div>

  <%!-- Real-time Activity Log --%>
  <div :if={@activity_log != []} class="mt-8">
    <h2 class="text-2xl font-bold text-on-surface mb-4">Activity Log</h2>
    <.dm_card body_class="" variant="bordered" class="p-4 max-h-96 overflow-y-auto">
      <div class="space-y-2">
        <div
          :for={entry <- @activity_log}
          class="flex items-start gap-3 text-sm py-1 border-b border-outline-variant last:border-0"
        >
          <span class={[
            "inline-block w-2 h-2 rounded-full mt-1.5 shrink-0",
            activity_dot_color(entry)
          ]}>
          </span>
          <div class="min-w-0 flex-1">
            <span class="text-on-surface-variant text-xs">
              {Map.get(entry, :source, "system")}
            </span>
            <span class="text-on-surface ml-2">{Map.get(entry, :message, "")}</span>
          </div>
        </div>
      </div>
    </.dm_card>
  </div>
</div>
