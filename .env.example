# Agent Hub configuration. Never commit populated secrets.
DB_PASSWORD=replace_with_a_unique_password
DATABASE_URL=postgresql://samgita:replace_with_a_unique_password@localhost:5432/samgita_hub_prod
POOL_SIZE=10
# Generate with mix phx.gen.secret.
SECRET_KEY_BASE=replace_with_a_generated_secret
PHX_HOST=samgita.example.com
PHX_SERVER=true
PORT=3110
HOST_PORT=3110
# Comma-separated REST API keys, required for protected production API access.
SAMGITA_API_KEYS=
RELEASE_COOKIE=replace_with_a_unique_cookie
SAMGITA_IMAGE=samgita:local
