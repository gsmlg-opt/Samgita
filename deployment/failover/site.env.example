# Copy to state/site.env on each host. Lines marked SHARED must be identical on
# both sites; the rest are per site. Use URL-safe passwords (e.g. openssl rand -hex 24).

# --- per site (example values for ms04; swap them on the cloud host) ---
SITE_NAME=ms04
PEER_SITE_NAME=cloud
# ssh destination of the peer host (key-based, BatchMode)
PEER_SSH=cloud
# failover directory on the peer host
PEER_DIR=/opt/samgita/deployment/failover
# this host's WireGuard address: database and web are published only here
WG_ADDR=10.88.0.1
# how the peer reaches this site's database / this site reaches the peer's
SELF_DB_HOST=10.88.0.1
PEER_DB_HOST=10.88.0.2
# proxy upstreams for "this site is primary" / "the peer is primary"
SELF_WEB_UPSTREAM=10.88.0.1:4870
PEER_WEB_UPSTREAM=10.88.0.2:4870

# --- SHARED ---
SAMGITA_HOST=samgita.example.com
SAMGITA_IMAGE=ghcr.io/gsmlg-dev/samgita:<version>
DB_PASSWORD=
REPLICATION_PASSWORD=
MONITOR_PASSWORD=
REWIND_PASSWORD=
# WAL kept for a disconnected standby before its slot is invalidated
MAX_SLOT_WAL_KEEP_SIZE=20GB
