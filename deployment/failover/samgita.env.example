# Copy to state/samgita.env. SHARED: identical on both sites, so either site can
# serve the same database (sessions, API keys, payload/lease keys, Codex hosts).
DATABASE_URL=postgresql://samgita:<DB_PASSWORD>@db:5432/samgita_hub_prod
POOL_SIZE=10
SECRET_KEY_BASE=
PHX_HOST=samgita.example.com
PHX_SERVER=true
PORT=4870
MIX_ENV=prod
RELEASE_COOKIE=
SAMGITA_API_KEYS=
SAMGITA_LEASE_KEYS=
SAMGITA_LEASE_KEY_ID=
SAMGITA_NATIVE_PAYLOAD_KEYS=
SAMGITA_NATIVE_PAYLOAD_KEY_ID=
SAMGITA_CODEX_HOST_SECRETS=
# Optional, only if already used:
# SAMGITA_EVENT_DESTINATIONS=
# SAMGITA_EVENT_CREDENTIALS=
# SAMGITA_GITHUB_HOSTS=
# SAMGITA_GITHUB_SECRETS=
